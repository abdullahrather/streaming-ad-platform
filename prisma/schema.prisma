// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// A person's level across the whole platform.
enum Role {
  ADMIN
  ADVERTISER
  GUEST
}

/// A person's level inside one organisation.
enum OrganisationRole {
  OWNER
  MANAGER
  ANALYST
}

/// PROCESSING -> PENDING_REVIEW -> APPROVED or REJECTED. FAILED means the video couldn't be converted.
enum CreativeStatus {
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

/// Guaranteed campaigns buy a fixed goal. Auction campaigns bid for what's left.
enum DeliveryType {
  GUARANTEED
  AUCTION
}

/// ASAP spends as fast as it can, EVEN spreads over the flight, CUSTOM aims for a daily target.
enum PacingMode {
  ASAP
  EVEN
  CUSTOM
}

/// Where an ad runs inside an episode.
enum AdSlot {
  PRE_ROLL
  MID_ROLL
  POST_ROLL
}

enum ReportGrouping {
  DAY
  CAMPAIGN
  SLOT
  COUNTRY
  DEVICE
  SHOW
}

enum ReportSchedule {
  NONE
  DAILY
  WEEKLY
}

enum RecommendationStatus {
  PENDING
  APPLIED
  REJECTED
  STALE
}

enum AlertType {
  UNDER_DELIVERY
  BUDGET_BURN
  SUDDEN_DROP
}

enum Device {
  CTV
  MOBILE
  WEB
  TABLET
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

/// A person who can sign in.
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String    @default("")
  passwordHash         String    @map("password_hash")
  role                 Role      @default(ADVERTISER)
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamptz(3)
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz(3)
  /// Encrypted. Only active once twoFactorEnabledAt is set.
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorEnabledAt   DateTime? @map("two_factor_enabled_at") @db.Timestamptz(3)
  /// The last accepted code's time step, so a code can't be used twice.
  twoFactorLastStep    BigInt?   @map("two_factor_last_step")
  /// Wrong codes in a row. Counted per account, because guesses can come from many addresses.
  twoFactorFailures    Int       @default(0) @map("two_factor_failures")
  twoFactorLockedUntil DateTime? @map("two_factor_locked_until") @db.Timestamptz(3)
  /// Hashed, one-use codes for a lost authenticator.
  recoveryCodes        String[]  @default([]) @map("recovery_codes")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaigns   Campaign[]
  memberships Membership[]
  sessions    Session[]
  tokens      OneTimeToken[]
  invitations Invitation[]

  @@map("users")
}

/// A company using the platform. Campaigns belong here, not to one person.
model Organisation {
  id          String    @id @default(cuid())
  name        String
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships     Membership[]
  campaigns       Campaign[]
  invitations     Invitation[]
  sessions        Session[]
  segments        AudienceSegment[]
  reports         Report[]
  alerts          Alert[]
  recommendations AiRecommendation[]
  balanceEntries  BalanceEntry[]
  invoices        Invoice[]

  @@map("organisations")
}

model Membership {
  userId         String           @map("user_id")
  organisationId String           @map("organisation_id")
  role           OrganisationRole
  /// Whether this member gets campaign alerts by email.
  alertEmails    Boolean          @default(true) @map("alert_emails")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId])
  @@index([organisationId])
  @@map("memberships")
}

/// Only hashes of invitation tokens are stored.
model Invitation {
  id             String           @id @default(cuid())
  organisationId String           @map("organisation_id")
  email          String
  role           OrganisationRole
  tokenHash      String           @unique @map("token_hash")
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("invitations")
}

/// One signed-in device. Refresh tokens rotate; only their hashes are stored.
model Session {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  activeOrganisationId String?   @map("active_organisation_id")
  refreshHash          String    @map("refresh_hash")
  previousRefreshHash  String?   @map("previous_refresh_hash")
  rotatedAt            DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent            String    @default("") @map("user_agent")
  ipAddress            String    @default("") @map("ip_address")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganisation Organisation? @relation(fields: [activeOrganisationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// Single-use links for email verification and password reset.
model OneTimeToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("one_time_tokens")
}

/// Append-only history of who changed what. Survives deleted users and organisations.
model AuditLog {
  id             String   @id @default(cuid())
  organisationId String?  @map("organisation_id")
  actorId        String?  @map("actor_id")
  actorEmail     String   @default("") @map("actor_email")
  action         String
  targetType     String   @default("") @map("target_type")
  targetId       String   @default("") @map("target_id")
  details        Json     @default("{}")
  ipAddress      String   @default("") @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Emails kept for the local mailbox when no mail server is configured.
model CapturedEmail {
  id          String   @id @default(cuid())
  recipient   String
  subject     String
  body        String
  link        String   @default("")
  /// Files sent with the email: filename, contentType and base64 content.
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("captured_emails")
}

/// A title in the streaming catalogue that ads can run against.
model Show {
  id       String @id @default(cuid())
  title    String @unique
  genre    String
  /// Storage key of the demo episode. Empty when no video exists.
  videoKey String @default("") @map("video_key")

  metrics Metric[]

  @@map("shows")
}

/// An advertising campaign owned by an Organisation. userId is whoever created it.
/// Empty target lists mean "all".
model Campaign {
  id                    String         @id @default(cuid())
  organisationId        String         @map("organisation_id")
  userId                String         @map("user_id")
  title                 String
  advertiser            String
  status                CampaignStatus @default(ACTIVE)
  budgetCents           Int            @map("budget_cents")
  cpmCents              Int            @map("cpm_cents")
  impressionGoal        Int            @map("impression_goal")
  startsAt              DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime       @map("ends_at") @db.Timestamptz(3)
  targetCountries       String[]       @default([]) @map("target_countries")
  targetGenres          String[]       @default([]) @map("target_genres")
  targetDevices         Device[]       @default([]) @map("target_devices")
  targetSlots           AdSlot[]       @default([]) @map("target_slots")
  targetSegmentIds      String[]       @default([]) @map("target_segment_ids")
  deliveryType          DeliveryType   @default(GUARANTEED) @map("delivery_type")
  pacingMode            PacingMode     @default(ASAP) @map("pacing_mode")
  dailyBudgetCents      Int?           @map("daily_budget_cents")
  dailyImpressionTarget Int?           @map("daily_impression_target")
  /// Most times one viewer sees this campaign in a day.
  frequencyCapPerDay    Int?           @map("frequency_cap_per_day")
  /// Hours (0-23) and weekdays (0 is Sunday) to run in. Empty means all.
  activeHours           Int[]          @default([]) @map("active_hours")
  activeDays            Int[]          @default([]) @map("active_days")
  /// Brands in the same category never run in the same ad break.
  competitiveCategory   String         @default("") @map("competitive_category")
  /// What was predicted when the campaign was created.
  forecastImpressions   Int?           @map("forecast_impressions")
  forecastReach         Int?           @map("forecast_reach")
  /// When it reached its goal or budget. A campaign that simply ran out of time ends at endsAt.
  completedAt           DateTime?      @map("completed_at") @db.Timestamptz(3)
  /// When its final invoice was issued, or when it closed with nothing to bill.
  billedAt              DateTime?      @map("billed_at") @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics         Metric[]
  creatives       Creative[]
  alerts          Alert[]
  recommendations AiRecommendation[]
  invoices        Invoice[]

  @@index([organisationId])
  @@index([userId])
  @@index([status, startsAt, endsAt])
  @@map("campaigns")
}

/// A video ad. It can only run once a platform admin has approved it.
model Creative {
  id              String         @id @default(cuid())
  campaignId      String         @map("campaign_id")
  name            String
  clickUrl        String         @map("click_url")
  /// Relative share of the campaign's impressions.
  weight          Int            @default(1)
  status          CreativeStatus @default(PROCESSING)
  /// Storage keys. The original is removed after conversion.
  originalKey     String         @default("") @map("original_key")
  videoKey        String         @default("") @map("video_key")
  posterKey       String         @default("") @map("poster_key")
  durationSeconds Float          @default(0) @map("duration_seconds")
  width           Int            @default(0)
  height          Int            @default(0)
  sizeBytes       Int            @default(0) @map("size_bytes")
  failureReason   String         @default("") @map("failure_reason")
  rejectionReason String         @default("") @map("rejection_reason")
  /// The AI content check, which only advises the reviewer. Empty until it has run.
  aiReview        Json?          @map("ai_review")
  createdById     String         @map("created_by_id")
  reviewedById    String?        @map("reviewed_by_id")
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metrics  CreativeMetric[]

  @@index([campaignId, status])
  @@index([status, createdAt])
  @@map("creatives")
}

/// Hourly results for each ad, used to compare them.
model CreativeMetric {
  creativeId  String   @map("creative_id")
  bucket      DateTime @db.Timestamptz(3)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  completions Int      @default(0)

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@id([creativeId, bucket])
  @@map("creative_metrics")
}

/// Viewers grouped by what they watch. Only includes viewers who consented.
model AudienceSegment {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  genres         String[]
  /// Ads seen in these genres before a viewer qualifies.
  minViews       Int      @default(3) @map("min_views")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("audience_segments")
}

/// Hourly ad requests, served or not, which is what forecasts are built from.
model InventoryHour {
  bucket   DateTime @db.Timestamptz(3)
  genre    String
  slot     AdSlot
  country  String   @db.Char(2)
  device   Device
  requests Int      @default(0)

  @@id([bucket, genre, slot, country, device])
  @@map("inventory_hours")
}

/// Estimated viewers each day, for turning impressions into reach.
model AudienceDay {
  day       String @id
  viewers   Int    @default(0)
  consented Int    @default(0)
  /// Everyone seen so far, up to and including this day.
  allTime   Int    @default(0) @map("all_time")

  @@map("audience_days")
}

/// Queue entries already written to metrics, so a redelivered entry changes nothing.
model ProcessedBatch {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("processed_batches")
}

/// Hourly count of rejected traffic. Never counted as delivery.
/// campaignId is empty when traffic was rejected before an ad was chosen.
model FilteredEvent {
  bucket     DateTime @db.Timestamptz(3)
  campaignId String   @map("campaign_id")
  reason     String
  count      Int      @default(0)

  @@id([bucket, campaignId, reason])
  @@index([campaignId])
  @@map("filtered_events")
}

/// Hourly rollup of ad events. One row per campaign, hour, show, slot, country
/// and device, so reads stay fast however many raw events arrive.
model Metric {
  campaignId     String   @map("campaign_id")
  showId         String   @map("show_id")
  slot           AdSlot
  country        String   @db.Char(2)
  device         Device
  bucket         DateTime @db.Timestamptz(3)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  /// What the impressions really cost. Auctions can clear below the CPM.
  costMillicents BigInt   @default(0) @map("cost_millicents")
  /// How many viewers reached 25%, 50% and 75% of the ad.
  firstQuartiles Int      @default(0) @map("first_quartiles")
  midpoints      Int      @default(0)
  thirdQuartiles Int      @default(0) @map("third_quartiles")
  completions    Int      @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  show     Show     @relation(fields: [showId], references: [id], onDelete: Restrict)

  @@id([campaignId, bucket, showId, slot, country, device])
  @@index([bucket])
  @@map("metrics")
}

/// A saved report: which campaigns, how rows are grouped, which columns, and when it's emailed.
model Report {
  id             String         @id @default(cuid())
  organisationId String         @map("organisation_id")
  createdById    String         @map("created_by_id")
  name           String
  /// Empty means every campaign in the organisation.
  campaignIds    String[]       @default([]) @map("campaign_ids")
  groupBy        ReportGrouping @default(DAY) @map("group_by")
  columns        String[]
  /// Each run covers this many days up to the moment it runs.
  rangeDays      Int            @default(7) @map("range_days")
  schedule       ReportSchedule @default(NONE)
  /// 0 is Sunday. Only used by weekly reports.
  sendWeekday    Int            @default(1) @map("send_weekday")
  /// Hour in the platform time zone.
  sendHour       Int            @default(8) @map("send_hour")
  /// Members of the organisation who receive it.
  recipientIds   String[]       @default([]) @map("recipient_ids")
  nextRunAt      DateTime?      @map("next_run_at") @db.Timestamptz(3)
  lastSentAt     DateTime?      @map("last_sent_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([nextRunAt])
  @@map("reports")
}

/// A problem with a campaign. One stays open per campaign and type until it clears.
model Alert {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  campaignId     String    @map("campaign_id")
  type           AlertType
  message        String
  details        Json      @default("{}")
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organisationId, openedAt])
  @@index([campaignId])
  @@map("alerts")
}

/// A change the AI assistant suggests. Nothing changes until an owner or manager approves it.
model AiRecommendation {
  id             String               @id @default(cuid())
  organisationId String               @map("organisation_id")
  campaignId     String               @map("campaign_id")
  createdById    String               @map("created_by_id")
  title          String
  reason         String
  /// Fields to change, in the same shape as PATCH /campaigns/:id.
  change         Json
  /// Those fields as they were, so an approval can tell if the campaign changed since.
  before         Json
  status         RecommendationStatus @default(PENDING)
  decidedById    String?              @map("decided_by_id")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([organisationId, createdAt])
  @@map("ai_recommendations")
}

/// The AI assistant's settings, chosen by a platform admin in the dashboard. One row.
/// AI_PROVIDER in .env takes priority over this.
model AiSetting {
  id          String   @id @default("default")
  enabled     Boolean  @default(false)
  provider    String
  model       String   @default("")
  baseUrl     String   @default("") @map("base_url")
  /// Encrypted with ENCRYPTION_KEY. Never sent to the browser.
  apiKey      String?  @map("api_key")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

enum BalanceEntryKind {
  CREDIT
  CHARGE
}

/// The prepaid balance, as an append-only ledger. The balance is the sum of amountCents:
/// credits are positive, charges negative. Rows are never edited.
model BalanceEntry {
  id             String           @id @default(cuid())
  organisationId String           @map("organisation_id")
  kind           BalanceEntryKind
  amountCents    Int              @map("amount_cents")
  description    String
  /// The invoice a charge pays. One charge per invoice.
  invoiceId      String?          @unique @map("invoice_id")
  createdById    String?          @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  // Checked at the end of the statement, so deleting an organisation removes both.
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: NoAction)

  @@index([organisationId, createdAt])
  @@map("balance_entries")
}

/// One per campaign, issued once its delivery is final. Names and amounts are copied in,
/// so an invoice reads the same after the campaign is renamed or deleted.
model Invoice {
  id               String   @id @default(cuid())
  /// INV-2026-00001: numbered in order within each year, with no gaps.
  number           String   @unique
  organisationId   String   @map("organisation_id")
  campaignId       String?  @unique @map("campaign_id")
  organisationName String   @map("organisation_name")
  campaignTitle    String   @map("campaign_title")
  advertiser       String
  periodStart      DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd        DateTime @map("period_end") @db.Timestamptz(3)
  impressions      Int
  clicks           Int
  /// Events removed as invalid traffic. Never billed.
  filteredEvents   Int      @map("filtered_events")
  subtotalCents    Int      @map("subtotal_cents")
  taxCents         Int      @default(0) @map("tax_cents")
  totalCents       Int      @map("total_cents")
  currency         String   @default("EUR") @db.Char(3)
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  charge       BalanceEntry?

  @@index([organisationId, issuedAt])
  @@map("invoices")
}

/// The last invoice number used in each year, so numbers have no gaps.
model InvoiceSequence {
  year Int @id
  last Int

  @@map("invoice_sequences")
}
