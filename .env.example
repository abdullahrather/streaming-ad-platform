# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API. Leave empty when the
# dashboard is served from the API itself or through the dev server.
CORS_ORIGIN=""

# Where links in emails should point.
APP_URL="http://localhost:5173"

# Leave empty to keep emails in the local mailbox while developing.
# Example: smtp://user:password@smtp.example.com:587
SMTP_URL=""
MAIL_FROM="Campaign Analytics <no-reply@example.com>"

# Uploaded and converted videos.
MEDIA_DIR=".data/media"
MAX_UPLOAD_MB=200

# Public demo settings. See render.yaml.
DEMO_MODE=false
TRUST_PROXY=0

# ─── Database ────────────────────────────────────────────────────────────────────
# Port 54329 is the local PostgreSQL started by `npm run dev`.
DATABASE_URL="postgresql://postgres:secret@localhost:54329/campaign_analytics?schema=public"
TEST_DATABASE_URL="postgresql://postgres:secret@localhost:54329/campaign_analytics_test?schema=public"

# ─── Redis ──────────────────────────────────────────────────────────────────────
# Started by `npm run dev` through Docker.
REDIS_URL="redis://localhost:6379"
# Set to false when running `node dist/worker.js` as its own process.
RUN_EVENT_WORKER=true

# Sends scheduled reports and checks campaigns for alerts. Every API process can run it safely.
RUN_SCHEDULER=true
# How often campaigns are checked for alerts, in milliseconds
ALERT_CHECK_MS=300000

# ─── AI assistant (optional) ─────────────────────────────────────────────────────
# Off when AI_PROVIDER is empty. Everything else in the platform works without it.
#   anthropic  Claude, with your own API key. AI_MODEL defaults to claude-opus-5-5.
#   openai     Any OpenAI-compatible API. Needs AI_API_KEY and AI_MODEL.
#   local      A model on this machine through Ollama: free, offline, no key.
#              AI_MODEL defaults to qwen2.5:7b; AI_BASE_URL to http://localhost:11434/v1.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Per person, per 15 minutes, for requests that call the model
AI_RATE_LIMIT=30

# ─── Secrets ─────────────────────────────────────────────────────────────────────
# `npm run dev` replaces these with random values when it creates .env.
JWT_SECRET="change-me-to-a-very-long-random-secret-at-least-256-bits"
JWT_EXPIRES_IN="15m"

# Encrypts two-factor secrets. If it changes, authenticators stop working until
# each person signs in with a recovery code and sets two-factor up again.
ENCRYPTION_KEY="change-me-to-another-long-random-secret-of-32-chars"

# Shared with the ad server or player that calls /ad-decision and /events.
INGEST_API_KEY="change-me-to-a-long-random-key"

# Lowest CPM an auction campaign can bid, in cents
AUCTION_FLOOR_CPM_CENTS=100
